# ==============================================================================
# altFINS Automated Trading Bot Configuration
# ==============================================================================

# altFINS API Configuration
# Get your API key from https://altfins.com
ALTFINS_API_KEY=your_altfins_api_key_here
ALTFINS_BASE_URL=https://altfins.com

# Bot Trading Mode: paper | live | webhook
TRADING_MODE=paper

# Exchange Configuration (for live mode: binance)
EXCHANGE=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=true

# Webhook Configuration (for webhook mode: sends JSON signals to 3Commas, Freqtrade, Discord, etc.)
WEBHOOK_URL=

# Trading Assets & Signals Filter
# Monitored symbols (comma-separated, e.g. BTC,ETH,SOL,ADA,DOT)
TRADING_SYMBOLS=BTC,ETH,SOL,BNB,XRP

# Signal direction filter: BULLISH | BEARISH | BOTH
ALLOWED_DIRECTIONS=BULLISH

# Specific altFINS signal keys to listen to (leave empty to accept all signals)
# Examples: FRESH_MOMENTUM_MACD_SIGNAL_LINE_CROSSOVER.TXT,SIGNALS_SUMMARY_SMA_50_200.TXT
ALLOWED_SIGNALS=

# Risk Management
INITIAL_PAPER_BALANCE_USDT=10000
POSITION_SIZE_USD=500
MAX_OPEN_POSITIONS=5
STOP_LOSS_PERCENTAGE=3.0
TAKE_PROFIT_PERCENTAGE=6.0
TRAILING_STOP_PERCENTAGE=1.5
USE_TRAILING_STOP=false

# Polling Interval (in milliseconds, e.g. 60000 for 1 minute)
POLL_INTERVAL_MS=60000

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
